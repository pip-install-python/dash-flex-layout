# flexlayout-dash docs site — every environment key run.py + lib/* read.
# Copy to .env for local overrides; run.py calls load_dotenv() before the lib
# imports, so values here are seen even by modules that read env at import
# time (lib/ad_client.py). ALL keys are optional: a plain `python run.py` with
# no .env is just the docs — no outbound calls, no secrets needed.

# Canonical origin (run.py). Every absolute URL the app emits — the canonical
# tag, og:url, sitemap.xml, robots.txt, the llms.txt links — is built from
# this. Leave unset in production: the default is the real public origin,
# which consolidates link equity onto one hostname instead of splitting it
# with *.onrender.com. Set it only for a preview/staging host.
# FLEXLAYOUT_BASE_URL=https://flexlayout.2plot.dev

# 2plot.dev ad network (lib/ad_client.py) — defaults shown. Dormant without a
# reachable ad server; slots render empty.
# AD_SERVER_URL=https://2plot.dev
# AD_APP_ID=flexlayout                     # SHORT key — must match SATELLITE_APP_KEY

# The hub's announcement feed, rendered in the llms.txt viewer header
# (lib/bulletin.py). Opt-in: unset means the feature is simply off — the
# viewer still renders, on the package's built-in tips and an empty
# "What's new". The package itself never reads this name; run.py feeds it to
# configure_bulletin(), so setting the var against unwired code does nothing.
# NETWORK_BULLETIN_URL=https://2plot.dev/api/network/bulletin
# NETWORK_BULLETIN_TTL_S=900

# 2plot.ai satellite traffic reporting (lib/satellite_reporter.py).
# Without CROSS_APP_WEBHOOK_SECRET, hits are still tracked locally but nothing
# is POSTed to the hub — the /traffic dashboard just won't show this app's
# numbers. Get the shared secret from the 2plot.ai deployment config.
# CROSS_APP_WEBHOOK_SECRET=
# SATELLITE_APP_KEY=flexlayout             # network-directory key for this app
# SATELLITE_TRAFFIC_URL=https://2plot.ai/api/satellite/traffic
# SATELLITE_REPORT_INTERVAL_S=3600
# SATELLITE_REPORT_DELAY_S=90

# Visitor analytics ledger (lib/analytics_tracker.py). Point at a mounted disk
# in production: on an ephemeral filesystem a mid-day deploy resets the ledger,
# and the next hourly report overwrites the hub's real total for today with
# whatever accumulated since the restart.
# TRAFFIC_ANALYTICS_FILE=/var/data/visitor_analytics.json
#
# Country comes from Cloudflare's CF-IPCountry header when present. The
# ip-api.com fallback is the only outbound call this app makes carrying a
# visitor IP, and it goes over plain HTTP — set 0 to disable it entirely.
# ANALYTICS_GEO_LOOKUP=0
# ANALYTICS_RETENTION_DAYS=45
# ANALYTICS_MAX_VISITS=20000
# ANALYTICS_FLUSH_EVERY=10
# ANALYTICS_FLUSH_INTERVAL_S=30

# Corpus document tiers (lib/page_tiers.py; registered in run.py).
# Access tier for the tiered corpus documents served by dash-improve-my-llms
# >= 2.4.0: /llms-small.txt (compact briefing) and /llms-full.txt (every
# page's prose in one fetch). Values: public | auth | admin | hidden.
# Unset = public — the network's standing policy is that discovery documents
# stay free; these knobs exist so the 402 experiment can tighten the full
# corpus per-satellite without a redeploy of anything else. On THIS site the
# tiers are recorded, not enforced: there is no auth and no access control
# wired (see run.py), so non-public values change nothing until that lands.
# LLMS_SMALL_TIER=public
# LLMS_FULL_TIER=public
